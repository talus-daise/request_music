{
  "name": "request-music",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public",
    "db:migrate": "wrangler d1 execute request_music --file=./migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 execute request_music --local --file=./migrations/0001_init.sql",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260501.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.17.0"
  }
}
